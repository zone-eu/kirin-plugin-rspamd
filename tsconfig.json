{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node"]
    },
    "include": ["index.js", "test/**/*.js", "types/**/*.d.ts"]
}
